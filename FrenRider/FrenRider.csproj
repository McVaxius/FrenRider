<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>

    <Version>4.1.0.2</Version>
    <FileVersion>4.1.0.2</FileVersion>
    <AssemblyVersion>4.1.0.2</AssemblyVersion>

    <PackageProjectUrl>https://github.com/McVaxius/FrenRider</PackageProjectUrl>

    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>

    <IsPackable>false</IsPackable>

  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI\AethertekUI.csproj" />
    <ProjectReference Include="..\..\aethertekUI\src\AethertekUI.Dalamud\AethertekUI.Dalamud.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.0.17" />
    <Reference Include="TerraFX.Interop.Windows">
      <HintPath>$(DalamudLibPath)/TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="images\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="data\bm\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="videos\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Update="Notices\Glasswork.MIT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyPluginArtifacts" AfterTargets="Build">

    <PropertyGroup>

      <PluginOutput>$(OutputPath)$(AssemblyName)</PluginOutput>

    </PropertyGroup>



    <MakeDir Directories="$(PluginOutput)" />



    <ItemGroup>

      <PluginFiles Include="$(TargetPath)" />
      <PluginFiles Include="$(OutputPath)AethertekUI.dll" />
      <PluginFiles Include="$(OutputPath)AethertekUI.Dalamud.dll" />
      <PluginFiles Include="$(OutputPath)Glasswork.dll" />
      <PluginFiles Include="$(OutputPath)Glasswork.Glass.dll" />
      <PluginFiles Include="$(OutputPath)Glasswork.Backend.dll" />
      <PluginFiles Include="$(ProjectDir)Notices\Glasswork.MIT.txt" />

      <PluginFiles Include="$(ProjectDir)$(AssemblyName).json" />
      <PluginFiles Include="$(ProjectDir)images\icon.png" />

      <PluginFiles Include="videos\**" />

      <PluginDataFiles Include="data\bm\**" />

    </ItemGroup>

    <Copy SourceFiles="@(PluginFiles)"

          DestinationFolder="$(PluginOutput)" />

    <Copy SourceFiles="@(PluginDataFiles)"

          DestinationFiles="@(PluginDataFiles->'$(PluginOutput)\data\bm\%(RecursiveDir)%(Filename)%(Extension)')" />

  </Target>

</Project>

